: null, "roundness": null, "seed": 1563812799, "version": 2, "versionNonce": 708991470, "isDeleted": false, "boundElements": null, "updated": 1730000000000, "link": null, "locked": false, "text": "End-to-end wireframes, flows, data model and delivery plan for the full website \u00b7 Frontier AI Research + Enterprise + Academy + Portals", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 14, "containerId": null, "originalText": "End-to-end wireframes, flows, data model and delivery plan for the full website \u00b7 Frontier AI Research + Enterprise + Academy + Portals", "autoResize": true, "lineHeight": 1.25}, {"id": "yTKBZfUbLDoREM5pasQm", "type": "rectangle", "x": 40.0, "y": 244.0, "width": 880.0, "height": 220.0, "angle": 0, "strokeColor": "#ced4da", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 364228584, "version": 2, "versionNonce": 1618711511, "isDeleted": false, "boundElements": null, "updated": 1730000000000, "link": null, "locked": false}, {"id": "4OB3uPmAX42xKtiEZ0S6", "type": "text", "x": 60.0, "y": 258.0, "width": 840.0, "height": 15.0, "angle": 0, "strokeColor": "#d9480f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 594414868, "version": 2, "versionNonce": 1764925816, "isDeleted": false, "boundElements": null, "updated": 1730000000000, "link": null, "locked": false, "text": "HOW TO READ THIS BOARD", "fontSize": 12, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 10, "containerId": null, "originalText": "HOW TO READ THIS BOARD", "autoResize": true, "lineHeight": 1.25}, {"id": "kBrnzMEt08Ceb2cRJtXb", "type": "text", "x": 60.0, "y": 282.0, "width": 840.0, "height": 90.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 291802562, "version": 2, "versionNonce": 870136869, "isDeleted": false, "boundElements": null, "updated": 1730000000000, "link": null, "locked": false, "text": "\u2022 Boards run top \u2192 bottom in the order of the index (right). Each board = banner (number \u00b7 name \u00b7 route) + wireframe + yellow DEV\nNOTES.\n\u2022 Red numbered badges on a wireframe map 1:1 to the numbered \"Section-by-section spec\" in the yellow panel.\n\u2022 Wireframes are DARK theme (the primary theme). Phones show the mobile layout; tablet collapses sidebar to drawer.\n\u2022 Flow diagrams use colour = actor (legend below). Mono font = routes / code.\n\u2022 Everything is placeholder content: logos, stats, names are replaced by real assets later (see Repo & env board).", "fontSize": 12, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 10, "containerId": null, "originalText": "\u2022 Boards run top \u2192 bottom in the order of the index (right). Each board = banner (number \u00b7 name \u00b7 route) + wireframe + yellow DEV\nNOTES.\n\u2022 Red numbered badges on a wireframe map 1:1 to the numbered \"Section-by-section spec\" in the yellow panel.\n\u2022 Wireframes are DARK theme (the primary theme). Phones show the mobile layout; tablet collapses sidebar to drawer.\n\u2022 Flow diagrams use colour = actor (legend below). Mono font = routes / code.\n\u2022 Everything is placeholder content: logos, stats, names are replaced by real assets later (see Repo & env board).", "autoResize": true, "lineHeight": 1.25}, {"id": "CbZoicNBNOY7QmDlaDSl", "type": "rectangle", "x": 40.0, "y": 484.0, "width": 22.0, "height": 16.0, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 1