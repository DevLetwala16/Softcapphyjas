; gst; total }   // display only\n}\n// persist: { name: 'scp-cart', version: 1, partialize: items+coupon }", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "baseline": 9, "containerId": null, "originalText": "type CartItem = { courseId: string; planId?: string; priceInr: number; qty: 1 }\ntype CartState = {\n  items: CartItem[]; coupon?: string\n  add(i: CartItem): void; remove(id: string): void; clear(): void\n  applyCoupon(code: string): Promise<void>\n  totals(): { subtotal; discount; gst; total }   // display only\n}\n// persist: { name: 'scp-cart', version: 1, partialize: items+coupon }", "autoResize": true, "lineHeight": 1.25}, {"id": "hJdmhPWdgSWXP3m0A8jl", "type": "rectangle", "x": 960.0, "y": 41623.0, "width": 880.0, "height": 120.25, "angle": 0, "strokeColor": "#45475a", "backgroundColor": "#1e1e2e", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 624828843, "version": 2, "versionNonce": 87809851, "isDeleted": false, "boundElements": null, "updated": 1730000000000, "link": null, "locked": false}, {"id": "BsDmVm0bjhlp5Es208Hq", "type": "text", "x": 972.0, "y": 41635.0, "width": 856.0, "height": 96.25, "angle": 0, "strokeColor": "#cdd6f4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 570760442, "version": 2, "versionNonce": 1773678453, "isDeleted": false, "boundElements": null, "updated": 1730000000000, "link": null, "locked": false, "text": "// Query key conventions\n['courses', filters]            // catalog\n['course', slug]                // detail\n['me','enrollments']            // student\n['order', orderId]              // polled on pending\n['admin','posts', {page,q}]     // admin tables\n// invalidate on mutation: queryClient.invalidateQueries({queryKey:['me']})