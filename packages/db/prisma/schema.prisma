generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Initial Foundation Model for verification
model SystemHealth {
  id        String   @id @default(cuid())
  status    String   @default("OK")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
