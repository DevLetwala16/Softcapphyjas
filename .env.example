# ── Core ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Softcapphyjas
NEXT_PUBLIC_FLAGSHIP_NAME=Synapse
NODE_ENV=development

# ── Database & Cache ──────────────────────────────────────
# PostgreSQL connection string (Postgres 16 + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/softcapphyjas
# Redis connection URL for BullMQ and session caching
REDIS_URL=redis://localhost:6379

# ── Auth.js v5 ────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
TOTP_ISSUER=Softcapphyjas

# ── Payments (Razorpay) ───────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_EMI_MIN_AMOUNT=3000
GST_RATE=0.18

# ── Storage (MinIO locally / Cloudflare R2 / AWS S3) ─────
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET_PUBLIC=softcapphyjas-public
S3_BUCKET_PRIVATE=softcapphyjas-private
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# ── Video Streaming (Mux) ─────────────────────────────────
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# ── Email (Resend or dev SMTP) ───────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Softcapphyjas <no-reply@softcapphyjas.com>"
HR_INBOX=careers@softcapphyjas.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ── AI (Groq & Gemini) ───────────────────────────────────
# Primary completions (Groq LLaMA 3.3 70B):
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m

# Fallback & Multimodal Embeddings (Google Gemini):
GEMINI_API_KEY=
AI_MODEL_CHAT=gemini-2.5-flash
AI_MODEL_REASONING=gemini-2.5-pro
EMBEDDING_MODEL=text-embedding-004
AI_DAILY_BUDGET_INR=500

# ── Security & Observability ─────────────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Ed25519 signing key for digital certificates:
CERT_SIGNING_PRIVATE_KEY=
